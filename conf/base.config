/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    sanger-tol/sequencecomposition Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Most of the pipeline requires very little resources
    cpus          = 1
    // but still gradually increase the resources to allow the pipeline to self-heal
    memory        = { 50.MB * task.attempt }
    time          = { 30.min * task.attempt }

    // Some steps need more memory on larger genomes

    withName: BGZIPTABIX {
        // 50 MB until 3 Gbp, 100 MB until 10 Gbp, then 200 MB except for mistletoe (using 50 Gbp as the cutoff)
        memory = { (meta.total_length < 3000000000 ? 50.MB : (meta.total_length < 10000000000 ? 100.MB : (meta.total_length < 50000000000 ? 200.MB : 1.GB))) * task.attempt }
        // 1.min per 1 Gbp = 30 min per 30 Gbp
        time   = { 30.min * task.attempt * Math.ceil(meta.total_length / 30000000000) }
    }

    withName: FASTAWINDOWS {
        // 1 CPU per 1 Gbp
        cpus   = { Math.ceil(fasta.size() / 1000000000) }
        // 100 MB per 40 Mbp
        memory = { 100.MB * task.attempt * Math.ceil(fasta.size() / 40000000) }
        // 1 second per 1 Mbp = 1 hour per 3.6 Gbp
        time   = { 1.h * task.attempt * Math.ceil(fasta.size() / 3600000000) }
    }
}
